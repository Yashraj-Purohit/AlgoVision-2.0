# Copy to .env and fill these from your Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy SUPABASE_ANON_KEY is also supported. Never use service_role or a secret key.
PORT=4173
# Optional for a future HTTPS deployment; loopback development uses false.
COOKIE_SECURE=false
